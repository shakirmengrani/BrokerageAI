# PostgreSQL
POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-password
SCRIPT_NAME=/pgadmin

# Application connection through PgBouncer
ConnectionStrings__DefaultConnection=Host=pgbouncer;Port=6432;Database=appdb;Username=postgres;Password=replace-with-a-strong-password
